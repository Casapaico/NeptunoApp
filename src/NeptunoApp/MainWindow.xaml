<Window x:Class="NeptunoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptuno · ADO .NET Semana 04 (WPF + MVVM + SP)"
        Height="760" Width="1100" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barra lateral ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="18,22">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="N" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Neptuno" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="NeptunoDB · SQL Server" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="MANTENIMIENTOS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,26,0,8"/>
                <RadioButton GroupName="Nav" Style="{StaticResource FilterChip}" HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left" Content="Productos" Margin="0,3"
                             IsChecked="True" Command="{Binding IrAProductosCommand}"/>
                <RadioButton GroupName="Nav" Style="{StaticResource FilterChip}" HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left" Content="Categorias" Margin="0,3"
                             Command="{Binding IrACategoriasCommand}"/>
                <RadioButton GroupName="Nav" Style="{StaticResource FilterChip}" HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left" Content="Proveedores" Margin="0,3"
                             Command="{Binding IrAProveedoresCommand}"/>
                <RadioButton GroupName="Nav" Style="{StaticResource FilterChip}" HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left" Content="Pedidos" Margin="0,3"
                             Command="{Binding IrAPedidosCommand}"/>

                <TextBlock Text="REPORTES" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,22,0,8"/>
                <RadioButton GroupName="Nav" Style="{StaticResource FilterChip}" HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left" Content="Detalle de pedidos por fecha" Margin="0,3"
                             Command="{Binding IrAReporteCommand}"/>

                <TextBlock Margin="2,28,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Acceso a datos con ADO.NET y procedimientos almacenados. SQL Server en la laptop (172.20.10.4)."/>
            </StackPanel>
        </Border>

        <!-- ===== Contenido de la seccion ===== -->
        <Grid Grid.Column="1" Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding SeccionActualNombre}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
            <ContentControl Grid.Row="1" Content="{Binding SeccionActual}"/>
        </Grid>
    </Grid>
</Window>
