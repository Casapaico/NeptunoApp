<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      ================================================================
      Conexion a SQL Server que corre en la LAPTOP (Ubuntu).
      La aplicacion WPF se ejecuta en la PC Windows institucional y se
      conecta por la red WiFi "iPhone de Alumno".

        Red:      iPhone de Alumno   (rango 172.20.10.0/28)
        Gateway:  172.20.10.1
        Laptop (SQL Server):  172.20.10.4 , puerto 1433

      Si la IP de la laptop cambia, verificarla en Ubuntu con:
        hostname -I        (o)   ip -4 addr show wlp0s20f3

      Usuario SQL:  sa
      ================================================================
    -->
    <add name="NeptunoDB"
         connectionString="Server=172.20.10.4,1433;Database=NeptunoDB;User Id=sa;Password=Meolvide2.0;TrustServerCertificate=True;Encrypt=True;Connect Timeout=15"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
