<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cadena de conexion centralizada en el proyecto de inicio (WPF), no en la
    Class Library de datos (NeptunoApp.Datos): ConfigurationManager solo lee
    el App.config del ejecutable en tiempo de ejecucion, nunca el de una
    biblioteca referenciada.

    Ajustar el Server= con la IP/nombre del servidor SQL:
      - misma maquina:     Server=localhost   (o  .\SQLEXPRESS)
      - equipo en la LAN:  Server=192.168.x.x,1433
  -->
  <connectionStrings>
    <add name="NeptunoDB"
         connectionString="Server=10.200.171.203,1433;Database=NeptunoDB;User Id=sa;Password=Meolvide2.0;TrustServerCertificate=True;Encrypt=True;Connect Timeout=15;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
