<UserControl x:Class="NeptunoApp.Views.ReporteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                   Text="Ejecuta usp_DetallePedido_ListarPorRangoFechas: INNER JOIN entre DetallePedidos y Pedidos, filtrado por FechaPedido."/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <Label Content="Desde"/>
                    <DatePicker SelectedDate="{Binding FechaInicio}" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <Label Content="Hasta"/>
                    <DatePicker SelectedDate="{Binding FechaFin}" Width="150"/>
                </StackPanel>
                <Button Content="Generar reporte" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Bottom" Command="{Binding GenerarCommand}"/>
            </StackPanel>
        </Border>

        <!-- ItemsSource bindea directo al DataTable desconectado (WPF resuelve
             IListSource -> DefaultView); las columnas usan el indexador de
             DataRowView, no propiedades. -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding [PedidoID]}" Width="70"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding [FechaPedido], StringFormat=d}" Width="110"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding [Cliente]}" Width="*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding [Producto]}" Width="*"/>
                <DataGridTextColumn Header="P. Unit" Binding="{Binding [PrecioUnidad], StringFormat=C2}" Width="90"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding [Cantidad]}" Width="60"/>
                <DataGridTextColumn Header="Dscto" Binding="{Binding [Descuento], StringFormat=P0}" Width="65"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding [Subtotal], StringFormat=C2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Mensaje}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0"
                   Visibility="{Binding Mensaje, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
    </Grid>
</UserControl>
