<UserControl x:Class="NeptunoApp.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="0,0,16,0"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionada}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCategoria}" Width="180"/>
                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Datos de la categoria" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Label Content="ID"/>
                <TextBox Text="{Binding CategoriaID}" IsReadOnly="True" Margin="0,0,0,10"/>

                <Label Content="Nombre *"/>
                <TextBox Text="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,0,0,10"/>

                <Label Content="Descripcion"/>
                <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                <UniformGrid Columns="2">
                    <Button Content="Nuevo" Style="{StaticResource OutlineButton}" Margin="0,0,4,6" Command="{Binding NuevoCommand}"/>
                    <Button Content="Guardar" Style="{StaticResource AccentButton}" Margin="4,0,0,6" Command="{Binding GuardarCommand}"/>
                    <Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="0,6,4,0" Command="{Binding EliminarCommand}"/>
                    <Button Content="Refrescar" Style="{StaticResource OutlineButton}" Margin="4,6,0,0" Command="{Binding CargarCommand}"/>
                </UniformGrid>

                <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Mensaje, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
