<UserControl x:Class="NeptunoApp.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <!-- Busqueda por nombreContacto y ciudad -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="Contacto"/>
                        <TextBox Width="150" Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="Ciudad"/>
                        <TextBox Width="130" Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Content="Buscar" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                            Margin="0,0,8,0" Command="{Binding BuscarCommand}"/>
                    <Button Content="Ver todos" Style="{StaticResource OutlineButton}" VerticalAlignment="Bottom"
                            Command="{Binding CargarCommand}"/>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="45"/>
                    <DataGridTextColumn Header="Compania" Binding="{Binding CompaniaNombre}" Width="*"/>
                    <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="140"/>
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="110"/>
                    <DataGridTextColumn Header="Pais" Binding="{Binding Pais}" Width="90"/>
                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel>
                    <TextBlock Text="Datos del proveedor" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Label Content="ID"/>
                    <TextBox Text="{Binding ProveedorID}" IsReadOnly="True" Margin="0,0,0,8"/>
                    <Label Content="Compania *"/>
                    <TextBox Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,0,0,8"/>
                    <Label Content="Nombre contacto"/>
                    <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,0,8"/>
                    <Label Content="Cargo contacto"/>
                    <TextBox Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,0,8"/>
                    <Label Content="Direccion"/>
                    <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,8"/>
                    <Label Content="Ciudad"/>
                    <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,0,0,8"/>
                    <Label Content="Codigo postal"/>
                    <TextBox Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,0,0,8"/>
                    <Label Content="Pais"/>
                    <TextBox Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,0,0,8"/>
                    <Label Content="Telefono"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Margin="0,0,0,8"/>
                    <Label Content="Fax"/>
                    <TextBox Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Margin="0,0,0,14"/>

                    <UniformGrid Columns="2">
                        <Button Content="Nuevo" Style="{StaticResource OutlineButton}" Margin="0,0,4,6" Command="{Binding NuevoCommand}"/>
                        <Button Content="Guardar" Style="{StaticResource AccentButton}" Margin="4,0,0,6" Command="{Binding GuardarCommand}"/>
                        <Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="0,6,0,0" Command="{Binding EliminarCommand}"/>
                        <TextBlock/>
                    </UniformGrid>

                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding Mensaje, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
