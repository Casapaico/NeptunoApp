<Window x:Class="NeptunoApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NeptunoApp.ViewModels"
        Title="Neptuno - ADO .NET Semana 04 (WPF + MVVM)" Height="640" Width="1040"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Background="#1F2937">
            <StackPanel Margin="12">
                <TextBlock Text="NEPTUNO" Foreground="White" FontWeight="Bold"
                           FontSize="18" Margin="4,4,4,2"/>
                <TextBlock Text="Mantenimientos" Foreground="#9CA3AF"
                           FontSize="12" Margin="4,0,4,14"/>

                <Button Content="Productos"   Margin="0,4" Height="40"
                        Command="{Binding VerProductosCommand}"/>
                <Button Content="Categorias"  Margin="0,4" Height="40"
                        Command="{Binding VerCategoriasCommand}"/>
                <Button Content="Proveedores" Margin="0,4" Height="40"
                        Command="{Binding VerProveedoresCommand}"/>
                <Button Content="Pedidos"     Margin="0,4" Height="40"
                        Command="{Binding VerPedidosCommand}"/>

                <TextBlock Text="Reportes" Foreground="#9CA3AF"
                           FontSize="12" Margin="4,18,4,4"/>
                <Button Content="Detalle de pedidos por fecha" Margin="0,4" Height="40"
                        Command="{Binding VerReportesCommand}"/>

                <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="11"
                           Margin="4,24,4,0"
                           Text="SQL Server en la laptop (172.20.10.4). Acceso a datos con ADO.NET y procedimientos almacenados."/>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}" Margin="16"/>
    </DockPanel>
</Window>
