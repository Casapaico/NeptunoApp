<UserControl x:Class="NeptunoApp.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Mantenimiento de Productos"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"        Binding="{Binding IdProducto}"       Width="45"/>
                    <DataGridTextColumn Header="Producto"  Binding="{Binding NombreProducto}"   Width="*"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding NombreCategoria}"  Width="130"/>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreProveedor}" Width="150"/>
                    <DataGridTextColumn Header="Precio"    Binding="{Binding PrecioUnidad, StringFormat=C2}" Width="80"/>
                    <DataGridTextColumn Header="Stock"     Binding="{Binding UnidadesEnExistencia}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Susp."  Binding="{Binding Suspendido}"       Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Datos" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Id"/>
                <TextBox Text="{Binding Id}" IsReadOnly="True" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Nombre producto *"/>
                <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Categoria"/>
                <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}"
                          DisplayMemberPath="Texto" Margin="0,2,0,8"/>

                <TextBlock Text="Proveedor"/>
                <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}"
                          DisplayMemberPath="Texto" Margin="0,2,0,8"/>

                <TextBlock Text="Cantidad por unidad"/>
                <TextBox Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Precio unidad"/>
                <TextBox Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Unidades en existencia"/>
                <TextBox Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Unidades en pedido"/>
                <TextBox Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Nivel nuevo pedido"/>
                <TextBox Text="{Binding NivelNuevoPedido, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <CheckBox Content="Suspendido" IsChecked="{Binding Suspendido}" Margin="0,4,0,12"/>

                <UniformGrid Columns="2">
                    <Button Content="Nuevo"    Height="34" Margin="0,0,4,4" Command="{Binding NuevoCommand}"/>
                    <Button Content="Guardar"  Height="34" Margin="4,0,0,4" Command="{Binding GuardarCommand}"/>
                    <Button Content="Eliminar" Height="34" Margin="0,4,4,0" Command="{Binding EliminarCommand}"/>
                    <Button Content="Refrescar" Height="34" Margin="4,4,0,0" Command="{Binding RefrescarCommand}"/>
                </UniformGrid>

                <TextBlock Text="{Binding Mensaje}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
