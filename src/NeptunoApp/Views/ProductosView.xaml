<UserControl x:Class="NeptunoApp.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="0,0,16,0"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionado}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="45"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="150"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=C2}" Width="85"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="60"/>
                <DataGridCheckBoxColumn Header="Desc." Binding="{Binding Descontinuado}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
                <StackPanel>
                    <TextBlock Text="Datos del producto" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Label Content="ID"/>
                    <TextBox Text="{Binding ProductoID}" IsReadOnly="True" Margin="0,0,0,8"/>
                    <Label Content="Nombre *"/>
                    <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,0,0,8"/>
                    <Label Content="Categoria"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}"
                              DisplayMemberPath="Texto" Margin="0,0,0,8"/>
                    <Label Content="Proveedor"/>
                    <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}"
                              DisplayMemberPath="Texto" Margin="0,0,0,8"/>
                    <Label Content="Cantidad por unidad"/>
                    <TextBox Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,0,0,8"/>
                    <Label Content="Precio unidad"/>
                    <TextBox Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <Label Content="Unidades en existencia"/>
                    <TextBox Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <Label Content="Unidades en pedido"/>
                    <TextBox Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <Label Content="Nivel de reorden"/>
                    <TextBox Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <CheckBox Content="Descontinuado" IsChecked="{Binding Descontinuado}" Margin="0,4,0,14"/>

                    <UniformGrid Columns="2">
                        <Button Content="Nuevo" Style="{StaticResource OutlineButton}" Margin="0,0,4,6" Command="{Binding NuevoCommand}"/>
                        <Button Content="Guardar" Style="{StaticResource AccentButton}" Margin="4,0,0,6" Command="{Binding GuardarCommand}"/>
                        <Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="0,6,4,0" Command="{Binding EliminarCommand}"/>
                        <Button Content="Refrescar" Style="{StaticResource OutlineButton}" Margin="4,6,0,0" Command="{Binding CargarCommand}"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding Mensaje, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
