<UserControl x:Class="NeptunoApp.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Mantenimiento de Pedidos"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock DockPanel.Dock="Bottom" Text="Detalle del pedido seleccionado"
                       FontWeight="Bold" Margin="0,10,0,4"/>
            <DataGrid DockPanel.Dock="Bottom" Height="170" ItemsSource="{Binding Detalle}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                    <DataGridTextColumn Header="P. Unit"  Binding="{Binding PrecioUnidad, StringFormat=C2}" Width="90"/>
                    <DataGridTextColumn Header="Cant."    Binding="{Binding Cantidad}" Width="60"/>
                    <DataGridTextColumn Header="Dscto"    Binding="{Binding Descuento, StringFormat=P0}" Width="60"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"       Binding="{Binding IdPedido}" Width="45"/>
                    <DataGridTextColumn Header="Cliente"  Binding="{Binding NombreCliente}" Width="*"/>
                    <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}" Width="130"/>
                    <DataGridTextColumn Header="F. Pedido" Binding="{Binding FechaPedido, StringFormat=d}" Width="90"/>
                    <DataGridTextColumn Header="Total"    Binding="{Binding TotalPedido, StringFormat=C2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Datos de cabecera" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Id"/>
                <TextBox Text="{Binding Id}" IsReadOnly="True" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Cliente *"/>
                <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSeleccionado}"
                          DisplayMemberPath="Texto" Margin="0,2,0,8"/>

                <TextBlock Text="Empleado"/>
                <ComboBox ItemsSource="{Binding Empleados}" SelectedItem="{Binding EmpleadoSeleccionado}"
                          DisplayMemberPath="Texto" Margin="0,2,0,8"/>

                <TextBlock Text="Fecha pedido"/>
                <DatePicker SelectedDate="{Binding FechaPedido}" Margin="0,2,0,8"/>

                <TextBlock Text="Fecha entrega"/>
                <DatePicker SelectedDate="{Binding FechaEntrega}" Margin="0,2,0,8"/>

                <TextBlock Text="Fecha envio"/>
                <DatePicker SelectedDate="{Binding FechaEnvio}" Margin="0,2,0,8"/>

                <TextBlock Text="Flete"/>
                <TextBox Text="{Binding Flete, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Destinatario"/>
                <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Ciudad destino"/>
                <TextBox Text="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5"/>

                <TextBlock Text="Pais destino"/>
                <TextBox Text="{Binding PaisDestino, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" Padding="5"/>

                <UniformGrid Columns="2">
                    <Button Content="Nuevo"    Height="34" Margin="0,0,4,4" Command="{Binding NuevoCommand}"/>
                    <Button Content="Guardar"  Height="34" Margin="4,0,0,4" Command="{Binding GuardarCommand}"/>
                    <Button Content="Eliminar" Height="34" Margin="0,4,4,0" Command="{Binding EliminarCommand}"/>
                    <Button Content="Refrescar" Height="34" Margin="4,4,0,0" Command="{Binding RefrescarCommand}"/>
                </UniformGrid>

                <TextBlock Text="{Binding Mensaje}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
