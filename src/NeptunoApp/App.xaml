<Application x:Class="NeptunoApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NeptunoApp.Converters"
             xmlns:vm="clr-namespace:NeptunoApp.ViewModels"
             xmlns:views="clr-namespace:NeptunoApp.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:BoolToStrikethroughConverter x:Key="BoolToStrikethrough"/>
            <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibility"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- Mapeo ViewModel de seccion -> UserControl -->
            <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
                <views:ProductosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
                <views:CategoriasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProveedoresViewModel}">
                <views:ProveedoresView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PedidosViewModel}">
                <views:PedidosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReporteViewModel}">
                <views:ReporteView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
